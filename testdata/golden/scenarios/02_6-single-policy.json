{
  "schemaVersion": "v1alpha1",
  "snapshot": {
    "listeners": [
      {
        "name": "listener~80",
        "address": ":::80",
        "filterChains": [
          {
            "name": "listener~80",
            "hcm": {
              "routeConfigName": "listener~80",
              "httpFilters": [
                {
                  "name": "envoy.filters.http.cors",
                  "typedConfig": {
                    "@type": "type.googleapis.com/envoy.extensions.filters.http.cors.v3.Cors"
                  },
                  "disabled": true
                },
                {
                  "name": "envoy.filters.http.router",
                  "typedConfig": {
                    "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                  }
                }
              ],
              "routeConfig": {
                "name": "listener~80",
                "virtualHosts": [
                  {
                    "name": "listener~80~api_example_com",
                    "domains": [
                      "api.example.com"
                    ],
                    "routes": [
                      {
                        "name": "listener~80~api_example_com-route-0-httproute-api-example-com-kgateway-system-0-0-matcher-0",
                        "match": {
                          "prefix": "/"
                        },
                        "cluster": "kube_httpbin_httpbin_8000",
                        "typedPerFilterConfig": {
                          "envoy.filters.http.cors": {
                            "@type": "type.googleapis.com/envoy.extensions.filters.http.cors.v3.CorsPolicy",
                            "allow_credentials": true,
                            "allow_headers": "content-type, authorization, x-request-id",
                            "allow_methods": "GET, POST, PUT, DELETE, OPTIONS",
                            "allow_origin_string_match": [
                              {
                                "exact": "https://app.example.com"
                              }
                            ],
                            "expose_headers": "x-request-id",
                            "max_age": "86400"
                          }
                        },
                        "metadata": {
                          "merge.EnterpriseKgatewayTrafficPolicy.enterprisekgateway.solo.io": {
                            "cors": [
                              "enterprisekgateway.solo.io/EnterpriseKgatewayTrafficPolicy/kgateway-system/cors"
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "warnings": []
}
